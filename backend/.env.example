# Rename this file to .env before running the server

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gamearena?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Port for the backend server
PORT=5001

# Secret key used to sign JWT tokens (use any long random string)
JWT_SECRET=nicknicknick

# JWT token expiry
JWT_EXPIRE=7d
